{
  "name": "@rpxl/riffle-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright E2E harness: real drags against the built examples, real engines.",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "capture": "playwright test --config=playwright.capture.config.ts",
    "generate-example-screenshots": "node scripts/generate-example-screenshots.mjs",
    "generate-og-image": "node scripts/generate-og-image.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
