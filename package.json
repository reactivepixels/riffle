{
  "name": "@rpxl/riffle-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/prettier-files.mjs --check",
    "format": "node scripts/prettier-files.mjs --write",
    "gates": "node scripts/check-prose.mjs && node scripts/check-agnostic.mjs && node scripts/check-snippets.mjs && node scripts/check-internal-refs.mjs",
    "check:snippets": "node scripts/check-snippets.mjs",
    "e2e": "pnpm -r --filter './packages/*' build && pnpm --filter @rpxl/riffle-e2e e2e",
    "mutation": "pnpm --filter @rpxl/riffle exec stryker run",
    "capture": "pnpm -r --filter './packages/*' build && pnpm --filter @rpxl/riffle-e2e run capture && node e2e/scripts/encode-hero.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  }
}
