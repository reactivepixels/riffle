---
/**
 * The showcase: six made-up products, each built around a live Riffle
 * stack, one flat colour band per scene. A standalone page with its own
 * layout (src/layouts/ShowcaseLayout.astro) rather than a Starlight page,
 * so the whole thing can be art directed. Every stack is the vanilla core
 * mounted by a small module under src/lib/showcase/, lazily, as its scene
 * nears the screen. The intro's fan of miniatures (IntroDeck.astro) is the
 * scene index.
 */
import ShowcaseLayout from '../layouts/ShowcaseLayout.astro'
import IntroDeck from '../components/showcase/IntroDeck.astro'
import BoardingPasses from '../components/showcase/BoardingPasses.astro'
import CrateDigging from '../components/showcase/CrateDigging.astro'
import HoloCards from '../components/showcase/HoloCards.astro'
import Flashcards from '../components/showcase/Flashcards.astro'
import CoffeeOrigins from '../components/showcase/CoffeeOrigins.astro'
import Stories from '../components/showcase/Stories.astro'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<ShowcaseLayout
  title="Six things you could build with Riffle"
  description="Six made-up products built on Riffle, the physics based card stack for Vanilla JS, React and Vue. Boarding passes, a record crate, trading cards, flashcards, coffee bags and city stories, all live and draggable."
>
  <header class="intro">
    <nav class="intro__nav" aria-label="Site">
      <a class="intro__brand" href={`${base}/`}>
        <svg viewBox="0 0 128 128" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M81 36 64 0 47 36l-1 2-9-10a6 6 0 0 0-9 9l10 10h-2L0 64l36 17h2L28 91a6 6 0 1 0 9 9l9-10 1 2 17 36 17-36v-2l9 10a6 6 0 1 0 9-9l-9-9 2-1 36-17-36-17-2-1 9-9a6 6 0 1 0-9-9l-9 10v-2Zm-17 2-2 5c-4 8-11 15-19 19l-5 2 5 2c8 4 15 11 19 19l2 5 2-5c4-8 11-15 19-19l5-2-5-2c-8-4-15-11-19-19l-2-5Z"
            clip-rule="evenodd"></path>
        </svg>
        Riffle
      </a>
      <ul class="intro__links">
        <li><a href={`${base}/#choose-your-framework`}>Docs</a></li>
        <li><a href="https://github.com/reactivepixels/riffle">GitHub</a></li>
      </ul>
    </nav>

    <div class="intro__main">
      <div class="intro__copy">
        <h1 class="intro__title">Six things you could build with Riffle</h1>
        <p class="intro__lede">Every stack on this page is live. The products are made up.</p>
      </div>
      <IntroDeck />
    </div>
  </header>

  <main>
    <BoardingPasses />
    <CrateDigging />
    <HoloCards />
    <Flashcards />
    <CoffeeOrigins />
    <Stories />
  </main>

  <footer class="outro">
    <div class="outro__inner">
      <h2 class="outro__title">Build your own</h2>
      <ul class="outro__links">
        <li><a href={`${base}/#choose-your-framework`}>Choose your framework</a></li>
        <li><a href="https://github.com/reactivepixels/riffle">GitHub</a></li>
      </ul>
      <p class="outro__note">
        Every airline, label, artist, creature, roaster and guide on this page is made up. The
        physics are real.
      </p>
    </div>
  </footer>
</ShowcaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100vh;
    min-height: 100svh;
    padding: 20px clamp(20px, 5vw, 80px) clamp(40px, 5vw, 64px);
    background: #0c0c0e;
    color: #f5f2ea;
    overflow-x: clip;
  }

  .intro__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  .intro__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: inherit;
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
  }

  .intro__brand svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .intro__links {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .intro__links a {
    display: inline-grid;
    place-items: center;
    min-height: 44px;
    color: inherit;
    font-size: 15px;
    font-weight: 400;
    text-decoration: none;
  }

  .intro__links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .intro a:focus-visible,
  .outro a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .intro__main {
    display: grid;
    align-items: center;
    gap: 56px;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) 0 0;
  }

  @media (min-width: 900px) {
    .intro__main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .intro__title {
    max-width: 14ch;
    font-size: clamp(40px, 5.2vw, 72px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .intro__lede {
    max-width: 36ch;
    margin-top: 20px;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.5;
    color: #dcd7cc;
  }

  .outro {
    padding: clamp(80px, 10vw, 128px) clamp(20px, 5vw, 80px) 48px;
    background: #ffd60a;
    color: #111111;
  }

  .outro__inner {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  .outro__title {
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .outro__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .outro__links a {
    display: inline-block;
    padding: 8px 0;
    color: inherit;
    font-size: 19px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .outro__links a:hover {
    text-decoration-thickness: 2px;
  }

  .outro__note {
    max-width: 60ch;
    margin-top: clamp(64px, 8vw, 96px);
    padding-top: 16px;
    border-top: 1px solid rgb(17 17 17 / 35%);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
  }
</style>
