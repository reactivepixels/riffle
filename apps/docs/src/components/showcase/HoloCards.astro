---
/**
 * Showcase scene 3: holo trading cards for a made-up game, on a dark field.
 * Each creature is a painted illustration from src/assets/showcase/creatures,
 * optimised by astro:assets. The foil and glare layers
 * read `--shift` and `--glow`, which src/lib/showcase/holo.ts writes from
 * the engine's drag event.
 */
import { Image } from 'astro:assets'
import Scene from './Scene.astro'
import fox from '../../assets/showcase/creatures/fox.jpg'
import wyrm from '../../assets/showcase/creatures/wyrm.jpg'
import moth from '../../assets/showcase/creatures/moth.jpg'
import turtle from '../../assets/showcase/creatures/turtle.jpg'
import owl from '../../assets/showcase/creatures/owl.jpg'
import { holoSource } from '../../lib/snippets'

const art = { fox, wyrm, moth, turtle, owl }

interface Creature {
  art: 'fox' | 'wyrm' | 'turtle' | 'moth' | 'owl'
  name: string
  type: string
  hp: number
  stage: string
  weak: string
  moves: { name: string; cost: number; damage: string }[]
  flavour: string
  number: string
  sky: [string, string]
  body: string
  accent: string
  frame: 'gold' | 'silver'
}

const creatures: Creature[] = [
  {
    art: 'fox',
    name: 'Emberfox',
    type: 'Ember',
    hp: 120,
    stage: 'Stage 1',
    weak: 'Tide',
    moves: [
      { name: 'Cinder Flick', cost: 1, damage: '30' },
      { name: 'Tail Bonfire', cost: 3, damage: '90' },
    ],
    flavour: 'Leaves warm footprints in fresh snow. Nobody has ever caught one asleep.',
    number: '014',
    sky: ['#ffb347', '#e8432e'],
    body: '#fff1e4',
    accent: '#c2410c',
    frame: 'gold',
  },
  {
    art: 'wyrm',
    name: 'Tidewyrm',
    type: 'Tide',
    hp: 140,
    stage: 'Stage 2',
    weak: 'Spark',
    moves: [
      { name: 'Undertow', cost: 2, damage: '50' },
      { name: 'King Swell', cost: 4, damage: '130' },
    ],
    flavour: 'Sailors blame it for every wave that arrives a second too early.',
    number: '037',
    sky: ['#4cc9f0', '#1d3fb8'],
    body: '#e8f4ff',
    accent: '#1d4ed8',
    frame: 'silver',
  },
  {
    art: 'moth',
    name: 'Voltmoth',
    type: 'Spark',
    hp: 80,
    stage: 'Basic',
    weak: 'Grove',
    moves: [
      { name: 'Static Dust', cost: 1, damage: '20' },
      { name: 'Porch Light', cost: 2, damage: '60' },
    ],
    flavour: 'Drawn to streetlights, which tend to flicker for a week afterwards.',
    number: '052',
    sky: ['#ffe066', '#8b5cf6'],
    body: '#f6f0ff',
    accent: '#6d28d9',
    frame: 'gold',
  },
  {
    art: 'turtle',
    name: 'Thornback',
    type: 'Grove',
    hp: 160,
    stage: 'Stage 2',
    weak: 'Ember',
    moves: [
      { name: 'Bramble Wall', cost: 2, damage: '40' },
      { name: 'Old Growth', cost: 4, damage: '120' },
    ],
    flavour: 'Moves one field a year. Moss grows on the shell faster than it walks.',
    number: '088',
    sky: ['#b5e48c', '#2d6a4f'],
    body: '#eef7e6',
    accent: '#3f6212',
    frame: 'silver',
  },
  {
    art: 'owl',
    name: 'Gloomowl',
    type: 'Dusk',
    hp: 100,
    stage: 'Stage 1',
    weak: 'Spark',
    moves: [
      { name: 'Hush', cost: 1, damage: '20' },
      { name: 'Midnight Stare', cost: 3, damage: '100' },
    ],
    flavour: 'Asks one question each night. Nobody remembers the answer by morning.',
    number: '101',
    sky: ['#7b6cf6', '#1b1340'],
    body: '#f0eeff',
    accent: '#4c1d95',
    frame: 'gold',
  },
]

const describe = (c: Creature) =>
  `${c.name}, ${c.type} type, ${c.hp} HP, moves ${c.moves[0]!.name} ${c.moves[0]!.damage} and ${c.moves[1]!.name} ${c.moves[1]!.damage}`
---

<Scene
  id="holo-cards"
  index="03"
  title="Trading cards"
  lede="Grab a corner and the card tilts on it. The foil follows the drag."
  config={['rotation: { maxRotation: 24 }', "on('drag')", 'progress', 'offset']}
  code={holoSource}
  class="holo-scene"
  style="--bg: #0e0b22; --ink: #f4f0ff;"
>
  <div class="holo-stage">
    <div class="holo-stack" data-stack role="group" aria-label="Shardlings trading cards">
      {
        creatures.map((c, i) => (
          <div
            class={`holo holo--${c.frame}`}
            data-label={describe(c)}
            style={`--sky-a: ${c.sky[0]}; --sky-b: ${c.sky[1]}; --body: ${c.body}; --accent: ${c.accent}; z-index: ${creatures.length - i};`}
          >
            <div class="holo__frame">
              <div class="holo__card">
                <div class="holo__head">
                  <p class="holo__stage">{c.stage}</p>
                  <p class="holo__name">{c.name}</p>
                  <p class="holo__hp">
                    <span>HP</span>
                    {c.hp}
                  </p>
                </div>

                <div class="holo__art">
                  <Image
                    src={art[c.art]}
                    alt=""
                    widths={[320, 640]}
                    sizes="(min-width: 900px) 300px, 70vw"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="holo__foil" aria-hidden="true" />
                  <span class="holo__sparkle" aria-hidden="true" />
                </div>

                <p class="holo__species">
                  {c.type} type Shardling, {c.stage.toLowerCase()}
                </p>

                <ul class="holo__moves">
                  {c.moves.map((move) => (
                    <li>
                      <span class="holo__cost" aria-hidden="true">
                        {Array.from({ length: move.cost }, () => (
                          <span />
                        ))}
                      </span>
                      <span class="holo__move">{move.name}</span>
                      <span class="holo__damage">{move.damage}</span>
                    </li>
                  ))}
                </ul>

                <dl class="holo__stats">
                  <div>
                    <dt>Weakness</dt>
                    <dd>{c.weak} x2</dd>
                  </div>
                  <div>
                    <dt>Resistance</dt>
                    <dd>None</dd>
                  </div>
                  <div>
                    <dt>Retreat</dt>
                    <dd>{c.moves[0]!.cost}</dd>
                  </div>
                </dl>

                <p class="holo__flavour">{c.flavour}</p>

                <div class="holo__foot">
                  <span>Shardlings</span>
                  <span>
                    {c.number}/120 <span aria-hidden="true">&#9733;</span>
                  </span>
                </div>
              </div>
            </div>
            <span class="holo__glare" aria-hidden="true" />
          </div>
        ))
      }
    </div>
    <div class="sc-controls">
      <p class="sc-note">Grab a corner and drag.</p>
    </div>
  </div>
</Scene>

<script>
  import { mountWhenNear } from '../../lib/showcase/lazy'
  import { mountHoloCards } from '../../lib/showcase/holo'

  const scene = document.getElementById('holo-cards')
  if (scene) mountWhenNear(scene, () => mountHoloCards(scene))
</script>

<style>



  .holo-stage {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .holo-stack {
    --w: min(330px, 62vw);
    position: relative;
    width: var(--w);
    aspect-ratio: 5 / 7;
    translate: calc(0.5 * (96px - 0.12 * var(--w))) 0;
  }

  .holo {
    --shift: 0;
    --glow: 0;
    position: absolute;
    inset: 0;
    container-type: inline-size;
    border-radius: 16px;
    cursor: grab;
    will-change: transform;
    box-shadow:
      0 2px 4px rgb(0 0 0 / 30%),
      0 30px 60px -20px rgb(0 0 0 / 70%),
      0 0 50px -10px color-mix(in srgb, var(--sky-a) 35%, transparent);
  }

  .holo:active {
    cursor: grabbing;
  }

  .holo:focus-visible {
    outline: 3px solid #f4f0ff;
    outline-offset: 5px;
  }

  .holo__frame {
    height: 100%;
    padding: 3.2cqw;
    border-radius: inherit;
    overflow: hidden;
    background:
      linear-gradient(
        125deg,
        #fff6d2 0%,
        #d6a945 18%,
        #fff2c0 34%,
        #b8862c 52%,
        #f7dd8f 70%,
        #a87420 86%,
        #f3d27e 100%
      );
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 70%);
  }

  .holo--silver .holo__frame {
    background: linear-gradient(
      125deg,
      #ffffff 0%,
      #a9b4c4 18%,
      #f4f7fb 34%,
      #8592a6 52%,
      #e6ebf2 70%,
      #7a879b 86%,
      #dfe5ee 100%
    );
  }

  .holo__card {
    display: flex;
    flex-direction: column;
    gap: 2cqw;
    height: 100%;
    overflow: hidden;
    padding: 3.4cqw 3.8cqw 3cqw;
    border-radius: 3cqw;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 60%), transparent 30%), var(--body);
    color: #17131f;
  }

  .holo__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    column-gap: 2cqw;
  }

  .holo__stage {
    grid-column: 1 / -1;
    font: 700 max(9px, 3cqw) / 1.1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3a3346;
  }

  .holo__name {
    font-size: max(15px, 8.6cqw);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .holo__hp {
    font-size: max(14px, 7cqw);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #9f1239;
  }

  .holo__hp span {
    margin-right: 0.6cqw;
    font-size: 0.5em;
    letter-spacing: 0.04em;
  }

  .holo__art {
    position: relative;
    overflow: hidden;
    flex: none;
    aspect-ratio: 100 / 64;
    border-radius: 1.6cqw;
    background: linear-gradient(160deg, var(--sky-a), var(--sky-b));
    box-shadow:
      0 0 0 0.8cqw rgb(255 255 255 / 70%),
      0 0 0 1.2cqw rgb(0 0 0 / 14%);
  }

  .holo__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The foil: a rainbow band twice the window's width, slid by --shift. */
  .holo__foil {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -50%;
    width: 200%;
    background: linear-gradient(
      105deg,
      transparent 24%,
      rgb(255 0 128 / 70%) 34%,
      rgb(255 214 0 / 70%) 41%,
      rgb(0 255 170 / 70%) 48%,
      rgb(0 180 255 / 70%) 55%,
      rgb(170 0 255 / 70%) 62%,
      transparent 72%
    );
    mix-blend-mode: color-dodge;
    opacity: calc(0.3 + var(--glow) * 0.7);
    transform: translateX(calc(var(--shift) * -42%));
    transition:
      transform 700ms var(--ease-out),
      opacity 700ms var(--ease-out);
  }

  .holo__sparkle {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle, rgb(255 255 255 / 90%) 0 0.4cqw, transparent 0.7cqw) 0 0 / 7cqw 6cqw,
      radial-gradient(circle, rgb(255 255 255 / 70%) 0 0.3cqw, transparent 0.6cqw) 3.5cqw 3cqw /
        7cqw 6cqw;
    mix-blend-mode: overlay;
    opacity: calc(0.15 + var(--glow) * 0.85);
    transition: opacity 700ms var(--ease-out);
  }

  /* A soft light across the whole card, sliding against the foil. */
  .holo__glare {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .holo__glare::before {
    content: '';
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: -60%;
    width: 120%;
    background: linear-gradient(
      100deg,
      transparent 30%,
      rgb(255 255 255 / 55%) 48%,
      rgb(255 255 255 / 0%) 62%
    );
    mix-blend-mode: soft-light;
    opacity: calc(0.25 + var(--glow) * 0.75);
    transform: translateX(calc(30% + var(--shift) * 70%));
    transition:
      transform 700ms var(--ease-out),
      opacity 700ms var(--ease-out);
  }

  .holo.is-held .holo__foil,
  .holo.is-held .holo__sparkle,
  .holo.is-held .holo__glare::before {
    transition: none;
  }

  .holo__species {
    padding: 1.2cqw 2.4cqw;
    border-radius: 99px;
    background: rgb(0 0 0 / 6%);
    font: 600 max(9px, 2.9cqw) / 1.2 var(--font-mono);
    color: #3a3346;
    text-align: center;
  }

  .holo__moves {
    display: grid;
    gap: 1.6cqw;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .holo__moves li {
    display: grid;
    grid-template-columns: 11cqw 1fr auto;
    align-items: center;
    gap: 2cqw;
    padding-bottom: 1.6cqw;
    border-bottom: 1px solid rgb(0 0 0 / 10%);
  }

  .holo__cost {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8cqw;
  }

  .holo__cost span {
    width: 3.2cqw;
    height: 3.2cqw;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: inset 0 -0.4cqw 0 rgb(0 0 0 / 25%);
  }

  .holo__move {
    font-size: max(11px, 4.6cqw);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .holo__damage {
    font-size: max(13px, 6cqw);
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .holo__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2cqw;
    margin: 0;
    text-align: center;
  }

  .holo__stats div {
    display: grid;
    gap: 0.8cqw;
  }

  .holo__stats dt {
    font: 700 max(8px, 2.5cqw) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3a3346;
  }

  .holo__stats dd {
    margin: 0;
    font-size: max(10px, 3.6cqw);
    font-weight: 800;
  }

  .holo__flavour {
    margin-top: auto;
    font: italic 500 max(9.5px, 3.3cqw) / 1.3 var(--font-serif);
    color: #3a3346;
  }

  .holo__foot {
    display: flex;
    justify-content: space-between;
    font: 700 max(8.5px, 2.7cqw) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3a3346;
  }


</style>
