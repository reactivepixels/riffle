---
/**
 * One showcase scene, laid out the same way every time: a flat colour band
 * with the live stack centred as the hero (the default slot, controls
 * included), then a caption row on a fixed grid, like a museum label. The
 * left side carries the scene number, title and one sentence; the right
 * side the configuration that makes it work, as plain monospace text, and a
 * "Show code" toggle whose panel opens full width beneath. A scene sets its
 * colours through `--bg` and `--ink` on its own root, so a script can flood
 * them at runtime.
 */
import { Code } from 'astro:components'
import { showcaseCodeTheme } from '../../lib/showcase/code-theme'

interface Props {
  id: string
  index: string
  title: string
  lede: string
  config: string[]
  code: string
  class?: string
  /** Inline custom properties for the scene root, `--bg` and `--ink` first. */
  style?: string
}

const { id, index, title, lede, config, code, class: className, style } = Astro.props
---

<section id={id} class:list={['scene', className]} aria-labelledby={`${id}-title`} style={style}>
  <div class="scene__stage">
    <slot />
  </div>

  <div class="scene__caption">
    <div class="scene__label">
      <p class="scene__number">{index}</p>
      <h2 class="scene__title" id={`${id}-title`}>{title}</h2>
      <p class="scene__lede">{lede}</p>
    </div>
    <p class="scene__config">
      {
        config.map((item, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <code>{item}</code>
          </>
        ))
      }
    </p>
    <details class="scene__code">
      <summary
        ><span class="scene__show">Show code</span><span class="scene__hide">Hide code</span
        ></summary
      >
      <div class="scene__code-panel">
        <Code code={code} lang="ts" theme={showcaseCodeTheme} />
      </div>
    </details>
  </div>
</section>

<style>
  .scene {
    --bg: #111;
    --ink: #fff;
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    gap: clamp(40px, 6vw, 72px);
    min-height: 100vh;
    min-height: 100svh;
    padding: clamp(64px, 8vw, 104px) clamp(20px, 5vw, 80px) clamp(40px, 5vw, 64px);
    background-color: var(--bg);
    color: var(--ink);
    overflow-x: clip;
  }

  .scene__stage {
    position: relative;
    display: grid;
    justify-items: center;
    min-width: 0;
  }

  .scene__caption {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    column-gap: 48px;
    row-gap: 16px;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  }

  @media (min-width: 900px) {
    .scene__caption {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .scene__config,
    .scene__code summary {
      text-align: right;
    }

    .scene__code {
      grid-column: 1 / -1;
      margin-top: -8px;
    }
  }

  .scene__number {
    font-size: 14px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .scene__title {
    margin-top: 4px;
    font-size: clamp(28px, 3.2vw, 44px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .scene__lede {
    max-width: 42ch;
    margin-top: 8px;
    font-size: 17px;
    font-weight: 400;
    line-height: 1.5;
  }

  .scene__config {
    align-self: end;
    font-size: 14px;
    line-height: 1.7;
  }

  .scene__config code {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .scene__code summary {
    display: block;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .scene__code summary::-webkit-details-marker {
    display: none;
  }

  .scene__code summary span {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
  }

  .scene__code summary:hover span {
    text-decoration-thickness: 2px;
  }

  .scene__code summary:focus-visible {
    outline: none;
  }

  .scene__code summary:focus-visible span {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .scene__hide,
  .scene__code[open] .scene__show {
    display: none;
  }

  .scene__code[open] .scene__hide {
    display: inline;
  }

  .scene__code-panel {
    margin-top: 20px;
    border-radius: 12px;
    background: #111116;
    overflow: hidden;
    text-align: left;
  }

  .scene__code-panel :global(pre) {
    margin: 0;
    padding: 22px 24px;
    font: 400 13px/1.65 var(--font-mono);
    tab-size: 2;
    overflow-x: auto;
    background-color: #111116 !important;
  }

  .scene__code-panel :global(pre:focus-visible) {
    outline: 2px solid #8fd3ff;
    outline-offset: -2px;
  }
</style>
