---
/**
 * Showcase scene 2: a crate of record sleeves for made-up artists, each
 * with its own painted cover from src/assets/showcase/covers, optimised by
 * astro:assets, and the title and artist set over it. Server rendered
 * here; src/lib/showcase/crate.ts mounts the engine and toggles the
 * `is-playing` class that slides the record out and spins it.
 */
import { Image } from 'astro:assets'
import Scene from './Scene.astro'
import bloom from '../../assets/showcase/covers/bloom.jpg'
import hymns from '../../assets/showcase/covers/hymns.jpg'
import staticCover from '../../assets/showcase/covers/static.jpg'
import parallax from '../../assets/showcase/covers/parallax.jpg'
import machines from '../../assets/showcase/covers/machines.jpg'
import moss from '../../assets/showcase/covers/moss.jpg'
import { crateSource } from '../../lib/snippets'

const covers = { bloom, hymns, static: staticCover, parallax, machines, moss }

/** Type colour over each cover: dark on the light covers, light on the dark ones. */
const inks: { [art: string]: string } = {
  bloom: '#1a1612',
  hymns: '#f4efe6',
  static: '#1a1612',
  parallax: '#f4efe6',
  machines: '#f4efe6',
  moss: '#24302a',
}

interface Record {
  art: 'bloom' | 'hymns' | 'static' | 'parallax' | 'machines' | 'moss'
  title: string
  artist: string
  label: string
  price: string
}

const records: Record[] = [
  { art: 'bloom', title: 'Concrete Bloom', artist: 'Mira Solano', label: '#e63b2e', price: '24' },
  {
    art: 'hymns',
    title: 'Night Bus Hymns',
    artist: 'The Low Lanterns',
    label: '#ffb238',
    price: '19',
  },
  {
    art: 'static',
    title: 'Tangerine Static',
    artist: 'Odalys and the Wires',
    label: '#ff4fa3',
    price: '22',
  },
  {
    art: 'parallax',
    title: 'Parallax',
    artist: 'Kofi Mensah-Dahl',
    label: '#ffe14d',
    price: '27',
  },
  {
    art: 'machines',
    title: 'Soft Machines',
    artist: 'Ines Varga Quartet',
    label: '#3fb0b0',
    price: '21',
  },
  { art: 'moss', title: 'Moss Hours', artist: 'Heron Coast', label: '#9fd18b', price: '18' },
]

const describe = (r: Record) => `${r.title} by ${r.artist}`
---

<Scene
  id="crate-digging"
  index="02"
  title="Record crate"
  lede="Sleeves loop like a shop bin. When the stack settles, the record slides out."
  config={["bounds: 'loop'", "on('settle')", "on('dragstart')"]}
  code={crateSource}
  class="crate-scene"
  style="--bg: #ff5a1f; --ink: #140c08;"
>
  <div class="crate-stage">
    <div class="crate-rig">
      <div class="crate-stack" data-stack role="group" aria-label="Record crate, new arrivals">
        {
          records.map((record, i) => (
            <div
              class="sleeve"
              data-label={describe(record)}
              style={`--label: ${record.label}; z-index: ${records.length - i};`}
            >
              <div class="disc" aria-hidden="true">
                <div class="disc__spin">
                  <div class="disc__label">
                    <span>Side A</span>
                    <span>33</span>
                  </div>
                </div>
              </div>

              <div class="cover">
                <Image
                  class="cover__img"
                  src={covers[record.art]}
                  alt=""
                  widths={[320, 640]}
                  sizes="(min-width: 900px) 320px, 60vw"
                  loading="lazy"
                  decoding="async"
                />
                <div class="cover__text" style={`color: ${inks[record.art]}`}>
                  <p class="cover__title">{record.title}</p>
                  <p class="cover__artist">{record.artist}</p>
                </div>
                <span class="cover__wear" />
                <span class="cover__gloss" />
              </div>

              {i % 2 === 0 && (
                <span class="sleeve__sticker" aria-hidden="true">
                  <small>£</small>
                  {record.price}
                </span>
              )}
            </div>
          ))
        }
      </div>
      <div class="crate-ledge" aria-hidden="true"></div>
    </div>

    <div class="sc-controls">
      <p class="sc-note">
        Now playing: <span data-now-playing>{describe(records[0]!)}</span>
      </p>
      <p class="sc-note crate-hint">Drag sideways. It loops.</p>
    </div>
  </div>
</Scene>

<script>
  import { mountWhenNear } from '../../lib/showcase/lazy'
  import { mountCrateDigging } from '../../lib/showcase/crate'

  const scene = document.getElementById('crate-digging')
  if (scene) mountWhenNear(scene, () => mountCrateDigging(scene))
</script>

<style>
  .crate-stage {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .crate-hint {
    flex-basis: 100%;
  }

  .crate-rig {
    --w: min(420px, 54vw);
    display: grid;
    justify-items: center;
    width: 100%;
    padding-top: 52px;
  }

  .crate-stack {
    position: relative;
    width: var(--w);
    aspect-ratio: 1;
    /*
     * Centre the whole group (the fan to the left plus the record sliding out
     * to the right), not the front sleeve alone.
     */
    translate: calc(45px - 0.21 * var(--w)) 0;
  }


  .crate-ledge {
    position: relative;
    z-index: 20;
    width: min(640px, 100%);
    height: 16px;
    margin-top: -4px;
    border-radius: 4px;
    background: linear-gradient(180deg, #3a2216, #140c08);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 18%) inset,
      0 26px 30px -14px rgb(20 12 8 / 60%);
    pointer-events: none;
  }

  .sleeve {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    cursor: grab;
    will-change: transform;
  }

  .sleeve:active {
    cursor: grabbing;
  }

  .sleeve:focus-visible {
    outline: 3px solid #140c08;
    outline-offset: 5px;
  }

  /* The record: slides out on .is-playing, spins inside its own layer. */
  .disc {
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    transition: transform 900ms var(--ease-out);
  }

  .sleeve.is-playing .disc {
    transform: translateX(38%);
  }

  .disc::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 20deg,
      transparent 0 6%,
      rgb(255 255 255 / 16%) 11%,
      transparent 17% 50%,
      rgb(255 255 255 / 11%) 61%,
      transparent 67%
    );
    pointer-events: none;
  }

  .disc__spin {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 33%, rgb(255 255 255 / 7%) 33.5% 34%, transparent 34.5%),
      radial-gradient(circle, transparent 0 62%, rgb(255 255 255 / 5%) 62.5% 63%, transparent 63.5%),
      repeating-radial-gradient(circle, #121212 0 1.2px, #1e1e1e 1.6px 2.6px), #121212;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 6%) inset,
      0 18px 34px -10px rgb(0 0 0 / 55%);
    animation: crate-spin 3.2s linear infinite;
    animation-play-state: paused;
  }

  .sleeve.is-playing .disc__spin {
    animation-play-state: running;
  }

  @keyframes crate-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .disc__label {
    position: absolute;
    inset: 33%;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 7cqw;
    border-radius: 50%;
    background:
      radial-gradient(circle, #121212 0 4.5%, transparent 5%),
      radial-gradient(circle, transparent 0 42%, rgb(0 0 0 / 14%) 43% 44%, transparent 45%), var(--label);
    color: #140c08;
    font: 800 max(7px, 2.4cqw) / 1 var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .disc__spin {
      animation: none;
    }
  }

  /* The sleeve. */
  .cover {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    border-radius: 1.4cqw;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 35%) inset,
      0 0 0 1px rgb(0 0 0 / 8%) inset,
      0 2px 4px rgb(20 12 8 / 25%),
      0 22px 40px -14px rgb(20 12 8 / 60%);
  }

  .cover > span {
    pointer-events: none;
  }

  .cover__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover__text {
    position: absolute;
    z-index: 2;
    top: 7cqw;
    left: 7cqw;
    right: 24cqw;
    display: grid;
    gap: 1.6cqw;
  }

  .cover__title,
  .cover__artist {
    margin: 0;
  }

  .cover__title {
    font: 600 max(12px, 6cqw) / 1.05 var(--font-display);
    letter-spacing: -0.01em;
  }

  .cover__artist {
    font: 400 max(10px, 3.6cqw) / 1.2 var(--font-display);
    opacity: 0.85;
  }

  .cover__gloss {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(118deg, rgb(255 255 255 / 26%) 0%, rgb(255 255 255 / 6%) 28%, transparent 42%),
      linear-gradient(0deg, rgb(0 0 0 / 10%), transparent 30%);
  }

  .cover__wear {
    position: absolute;
    inset: 7%;
    z-index: 3;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      transparent 0 66%,
      rgb(255 255 255 / 10%) 68% 69.5%,
      transparent 71.5%
    );
  }

  .sleeve__sticker {
    position: absolute;
    z-index: 4;
    top: 5cqw;
    right: 5cqw;
    display: grid;
    place-items: center;
    grid-auto-flow: column;
    width: 15cqw;
    height: 15cqw;
    border-radius: 50%;
    background: #fff8e6;
    color: #b42318;
    font: 900 max(11px, 5.2cqw) / 1 var(--font-display);
    letter-spacing: -0.04em;
    rotate: 12deg;
    box-shadow: 0 2px 4px rgb(0 0 0 / 22%);
  }

  .sleeve__sticker small {
    font-size: 0.6em;
  }

  /* Readout under the crate. */
</style>
