---
/**
 * Showcase scene 6: 9:16 story cards for a made-up weekend city guide, with
 * a segmented progress bar that auto-advances. Each story's art is an
 * inline SVG poster. Mounted by src/lib/showcase/stories.ts, which owns the
 * timer and every reason it waits.
 */
import Scene from './Scene.astro'
import { storiesSource } from '../../lib/snippets'

interface Story {
  art: 'sunrise' | 'jacaranda' | 'market' | 'rooftop' | 'lake' | 'tacos'
  day: string
  time: string
  tag: string
  text: string
}

const stories: Story[] = [
  {
    art: 'sunrise',
    day: 'Saturday',
    time: '08:30',
    tag: 'Breakfast',
    text: 'Chilaquiles verdes and a coffee strong enough to argue with.',
  },
  {
    art: 'jacaranda',
    day: 'Saturday',
    time: '11:00',
    tag: 'Walk',
    text: 'Roma Norte under the jacarandas. Look up. The purple is the point.',
  },
  {
    art: 'market',
    day: 'Saturday',
    time: '14:00',
    tag: 'Lunch',
    text: 'A market counter, a plastic stool, and whatever the cook says is good today.',
  },
  {
    art: 'rooftop',
    day: 'Saturday',
    time: '19:30',
    tag: 'Rooftop',
    text: 'Golden hour over the old town. Bring a jacket, it cools fast.',
  },
  {
    art: 'lake',
    day: 'Sunday',
    time: '10:00',
    tag: 'Park',
    text: 'Chapultepec by pedal boat. Go slowly and call it exercise.',
  },
  {
    art: 'tacos',
    day: 'Sunday',
    time: '13:00',
    tag: 'Tacos',
    text: 'Al pastor off the spit. Order two more than you planned.',
  },
]

// Jacaranda blossom: a stable scatter of circles, built once at build time.
const blossom = Array.from({ length: 70 }, (_, i) => {
  const a = (i * 137.508 * Math.PI) / 180
  const r = 6 + Math.sqrt(i) * 5.2
  return {
    cx: +(45 + Math.cos(a) * r * 1.25).toFixed(1),
    cy: +(42 + Math.sin(a) * r * 0.7).toFixed(1),
    r: +(2.4 + ((i * 7) % 5) * 0.55).toFixed(1),
    fill: ['#b794f6', '#9f7aea', '#d6bcfa', '#805ad5'][i % 4],
  }
})

const flags = ['#ff4f8b', '#ffd23f', '#3ad1c4', '#ff7a1a', '#8b5cf6', '#ffffff']
---

<Scene
  id="stories"
  index="06"
  kicker="City guide"
  title="Stories that wait for you."
  lede="A weekend guide that plays itself. The bar on top calls next() every few seconds, and it holds still the moment you grab, hover or focus a story. With reduced motion on, it never moves by itself."
  features={['next()', "on('change')", "on('dragstart')", 'prefers-reduced-motion']}
  code={storiesSource}
  flip
  class="stories-scene"
  style="--bg: #ff4f8b; --ink: #1b0612;"
>
  <div class="stories-stage">
    <div class="stories-stack" data-stack role="group" aria-label="Two Days In, Mexico City">
      <div class="story-bar" data-bar aria-hidden="true">
        {
          stories.map((_, i) => (
            <span class:list={['story-bar__segment', { 'is-active': i === 0 }]}>
              <span class="story-bar__fill" />
            </span>
          ))
        }
      </div>

      {
        stories.map((s, i) => (
          <div
            class={`story story--${s.art}`}
            data-label={`${s.day} ${s.time}, ${s.tag}: ${s.text}`}
            style={`z-index: ${stories.length - i};`}
          >
            <svg
              class="story__art"
              viewBox="0 0 90 160"
              preserveAspectRatio="xMidYMid slice"
              aria-hidden="true"
            >
              <defs>
                <linearGradient id={`story-sky-${i}`} x1="0" y1="0" x2="0" y2="1">
                  {s.art === 'sunrise' && (
                    <>
                      <stop offset="0" stop-color="#ffd27a" />
                      <stop offset="0.55" stop-color="#ff7b54" />
                      <stop offset="1" stop-color="#c2185b" />
                    </>
                  )}
                  {s.art === 'jacaranda' && (
                    <>
                      <stop offset="0" stop-color="#e9ddff" />
                      <stop offset="1" stop-color="#8f6ee0" />
                    </>
                  )}
                  {s.art === 'market' && (
                    <>
                      <stop offset="0" stop-color="#11706a" />
                      <stop offset="1" stop-color="#0b3b38" />
                    </>
                  )}
                  {s.art === 'rooftop' && (
                    <>
                      <stop offset="0" stop-color="#ffb347" />
                      <stop offset="0.5" stop-color="#ff5e62" />
                      <stop offset="1" stop-color="#3b1d5e" />
                    </>
                  )}
                  {s.art === 'lake' && (
                    <>
                      <stop offset="0" stop-color="#c8f3dc" />
                      <stop offset="0.45" stop-color="#6cc3a0" />
                      <stop offset="0.46" stop-color="#2a8aa8" />
                      <stop offset="1" stop-color="#164e63" />
                    </>
                  )}
                  {s.art === 'tacos' && (
                    <>
                      <stop offset="0" stop-color="#ffb000" />
                      <stop offset="1" stop-color="#ff3d7f" />
                    </>
                  )}
                </linearGradient>
              </defs>
              <rect width="90" height="160" fill={`url(#story-sky-${i})`} />

              {s.art === 'sunrise' && (
                <g>
                  <circle cx="45" cy="70" r="26" fill="#fff1b8" />
                  <circle cx="45" cy="70" r="34" fill="#fff1b8" opacity="0.25" />
                  <path d="M0 86q22-14 45-4t45-6v84H0Z" fill="#e8505b" />
                  <path d="M0 100q30-16 60-4t30 0v64H0Z" fill="#a4134d" />
                  <path d="M0 116q24-8 50 0t40-4v48H0Z" fill="#6d0f3c" />
                  <path d="M20 40q3-3 6 0q3-3 6 0M58 30q2-2 4 0q2-2 4 0" fill="none" stroke="#7a1f3d" stroke-width="1.2" stroke-linecap="round" />
                </g>
              )}
              {s.art === 'jacaranda' && (
                <g>
                  <path d="M45 160V78M45 98 30 70M45 90l16-24M45 110 22 86M45 104l22-14" stroke="#4a2c2a" stroke-width="3.2" stroke-linecap="round" fill="none" />
                  {blossom.map((b) => (
                    <circle cx={b.cx} cy={b.cy} r={b.r} fill={b.fill} />
                  ))}
                  <ellipse cx="45" cy="160" rx="60" ry="22" fill="#6b46c1" opacity="0.5" />
                  <circle cx="18" cy="118" r="1.6" fill="#d6bcfa" />
                  <circle cx="70" cy="126" r="1.4" fill="#b794f6" />
                  <circle cx="58" cy="140" r="1.8" fill="#d6bcfa" />
                </g>
              )}
              {s.art === 'market' && (
                <g>
                  {[22, 46].map((y, row) => (
                    <g>
                      <path d={`M-4 ${y}q49 ${10 + row * 2} 98 0`} stroke="#fff3" stroke-width="0.8" fill="none" />
                      {Array.from({ length: 8 }, (_, k) => {
                        const x = -2 + k * 12.5 + row * 6
                        const t = (x + 4) / 98
                        const sag = 4 * (10 + row * 2) * t * (1 - t)
                        return (
                          <path
                            d={`M${x} ${y + sag - 1}h9v12l-4.5 -3l-4.5 3Z`}
                            fill={flags[(k + row * 3) % flags.length]}
                          />
                        )
                      })}
                    </g>
                  ))}
                  <path d="M0 96h90v8H0Z" fill="#ff4f8b" />
                  <path d="M0 96h10l-5 10ZM20 96h10l-5 10ZM40 96h10l-5 10ZM60 96h10l-5 10ZM80 96h10l-5 10Z" fill="#fff" />
                  <path d="M0 104h90v56H0Z" fill="#06221f" />
                  <circle cx="22" cy="128" r="9" fill="#ffd23f" />
                  <circle cx="44" cy="124" r="11" fill="#ff7a1a" />
                  <circle cx="68" cy="128" r="9" fill="#3ad1c4" />
                </g>
              )}
              {s.art === 'rooftop' && (
                <g>
                  <circle cx="45" cy="92" r="22" fill="#ffe29a" />
                  <path d="M0 104h8V86h6v-6h4v6h6v18h6V72l6-8 6 8v32h6V90h8V78h4v12h8v14h6V88h6v16h4v56H0Z" fill="#2a1240" />
                  <path d="M38 64v-6M36 60h4" stroke="#2a1240" stroke-width="1.2" />
                  <path d="M0 118h90v42H0Z" fill="#1a0b2b" />
                  <path d="M6 124h78" stroke="#ffb347" stroke-width="0.8" stroke-dasharray="2 3" />
                  <circle cx="14" cy="122" r="1.2" fill="#ffe29a" />
                  <circle cx="30" cy="122" r="1.2" fill="#ffe29a" />
                  <circle cx="46" cy="122" r="1.2" fill="#ffe29a" />
                  <circle cx="62" cy="122" r="1.2" fill="#ffe29a" />
                  <circle cx="78" cy="122" r="1.2" fill="#ffe29a" />
                </g>
              )}
              {s.art === 'lake' && (
                <g>
                  <circle cx="16" cy="58" r="14" fill="#2f855a" />
                  <circle cx="30" cy="62" r="11" fill="#38a169" />
                  <circle cx="74" cy="56" r="16" fill="#276749" />
                  <path d="M10 92h16M52 100h22M20 110h30M8 124h20M50 132h28" stroke="#9ee7f5" stroke-width="1.2" stroke-linecap="round" opacity="0.7" />
                  <path d="M30 86h30l-4 8H34Z" fill="#fff" />
                  <path d="M34 86V76h22v10" fill="none" stroke="#fff" stroke-width="1.6" />
                  <path d="M32 76h26l-2-4H34Z" fill="#ff4f8b" />
                  <path d="M30 96h30" stroke="#0e3a4a" stroke-width="1" opacity="0.5" />
                </g>
              )}
              {s.art === 'tacos' && (
                <g>
                  <circle cx="45" cy="72" r="40" fill="none" stroke="#fff" stroke-opacity="0.18" stroke-width="6" />
                  <circle cx="45" cy="72" r="28" fill="none" stroke="#fff" stroke-opacity="0.14" stroke-width="5" />
                  <path d="M15 84a30 30 0 0 1 60 0Z" fill="#ffe08a" />
                  <path d="M20 82q4-10 9-4 4-9 9-3 5-8 9-2 5-8 9-1 5-7 9 1l3 9H18Z" fill="#c2410c" />
                  <path d="M24 80q3-5 6-1M38 77q3-5 6-1M52 78q3-5 6 0" stroke="#4ade80" stroke-width="2.4" stroke-linecap="round" fill="none" />
                  <path d="M15 84a30 30 0 0 1 60 0" fill="none" stroke="#e8b04a" stroke-width="2" />
                  <circle cx="70" cy="44" r="9" fill="#65a30d" />
                  <circle cx="70" cy="44" r="7" fill="#bef264" />
                  <path d="M70 37v14M63 44h14M65 39l10 10M75 39 65 49" stroke="#65a30d" stroke-width="0.8" />
                  <circle cx="20" cy="40" r="5" fill="#fff" opacity="0.9" />
                  <path d="M17 40h6" stroke="#ff3d7f" stroke-width="1" />
                </g>
              )}
            </svg>

            <div class="story__head">
              <span class="story__avatar" aria-hidden="true">2D</span>
              <p class="story__who">
                <span class="story__name">Two Days In</span>
                <span class="story__when">
                  Mexico City, {s.day.slice(0, 3)} {s.time}
                </span>
              </p>
            </div>

            <div class="story__caption">
              <p class="story__tag">
                {s.day} {s.time}, {s.tag}
              </p>
              <p class="story__text">{s.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="stories-controls">
      <button class="stories-button" type="button" data-prev aria-label="Previous story">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg>
      </button>
      <button
        class="stories-button stories-button--pause"
        type="button"
        data-pause
        aria-pressed="false"
        aria-label="Pause stories"
        hidden
      >
        <svg class="stories-icon-pause" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M8 5v14M16 5v14"></path></svg
        >
        <svg class="stories-icon-play" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M7 5v14l12-7Z"></path></svg
        >
      </button>
      <button class="stories-button" type="button" data-next aria-label="Next story">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
      </button>
    </div>
    <p class="stories-hint">Hover, focus or grab a story to hold it.</p>
  </div>
</Scene>

<script>
  import { mountWhenNear } from '../../lib/showcase/lazy'
  import { mountStories } from '../../lib/showcase/stories'

  const scene = document.getElementById('stories')
  if (scene) mountWhenNear(scene, () => mountStories(scene))
</script>

<style>
  :global(.stories-scene) {
    background-image:
      radial-gradient(50% 40% at 70% 40%, rgb(255 214 10 / 28%), transparent 70%),
      radial-gradient(40% 50% at 10% 90%, rgb(139 92 246 / 25%), transparent 70%);
  }

  .stories-stage {
    display: grid;
    justify-items: center;
    gap: 24px;
    width: 100%;
  }

  .stories-stack {
    --w: min(296px, 62vw);
    position: relative;
    width: var(--w);
    aspect-ratio: 9 / 16;
    translate: calc(0.5 * (64px - 0.08 * var(--w))) 0;
  }

  .story-bar {
    position: absolute;
    z-index: 100;
    top: 3.2%;
    left: 5%;
    right: 5%;
    display: flex;
    gap: 4px;
    pointer-events: none;
  }

  .story-bar__segment {
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(255 255 255 / 40%);
  }

  .story-bar__fill {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .story-bar__segment.is-done .story-bar__fill,
  .story-bar__segment.is-active .story-bar__fill {
    transform: scaleX(1);
  }

  .story-bar.is-running .story-bar__segment.is-active .story-bar__fill {
    animation: story-fill 5s linear forwards;
  }

  .story-bar.is-running.is-paused .story-bar__segment.is-active .story-bar__fill {
    animation-play-state: paused;
  }

  @keyframes story-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .story {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    overflow: hidden;
    border-radius: 22px;
    background: #1b0612;
    color: #fff;
    cursor: grab;
    will-change: transform;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 10%),
      0 2px 4px rgb(27 6 18 / 25%),
      0 30px 60px -20px rgb(27 6 18 / 60%);
  }

  .story:active {
    cursor: grabbing;
  }

  .story:focus-visible {
    outline: 3px solid #1b0612;
    outline-offset: 5px;
  }

  .story__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .story::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(12 4 16 / 55%), transparent 22%),
      linear-gradient(0deg, rgb(12 4 16 / 88%) 0%, rgb(12 4 16 / 55%) 26%, transparent 48%);
    pointer-events: none;
  }

  .story__head,
  .story__caption {
    position: absolute;
    z-index: 1;
    left: 6.5cqw;
    right: 6.5cqw;
  }

  .story__head {
    top: 10cqw;
    display: flex;
    align-items: center;
    gap: 3cqw;
  }

  .story__avatar {
    display: grid;
    place-items: center;
    width: 11cqw;
    height: 11cqw;
    flex: none;
    border-radius: 50%;
    background: #ffd60a;
    color: #1b0612;
    font: 900 max(10px, 4cqw) / 1 var(--font-display);
    letter-spacing: -0.04em;
    box-shadow: 0 0 0 0.8cqw rgb(255 255 255 / 85%);
  }

  .story__who {
    display: grid;
    gap: 0.6cqw;
  }

  .story__name {
    font-size: max(12px, 4.6cqw);
    font-weight: 800;
  }

  .story__when {
    font-size: max(11px, 3.8cqw);
    font-weight: 600;
  }

  .story__caption {
    bottom: 8cqw;
    display: grid;
    gap: 3cqw;
  }

  .story__tag {
    justify-self: start;
    padding: 1.6cqw 3.2cqw;
    border-radius: 99px;
    background: #ffd60a;
    color: #1b0612;
    font: 800 max(10px, 3.4cqw) / 1 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .story__text {
    font-family: var(--font-rounded);
    font-size: max(16px, 8.4cqw);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .stories-controls {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .stories-button {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 2px solid #1b0612;
    border-radius: 50%;
    background: transparent;
    color: #1b0612;
    cursor: pointer;
    transition: transform 200ms var(--ease-out);
  }

  .stories-button:hover {
    transform: scale(1.06);
  }

  .stories-button:focus-visible {
    outline: 3px solid #1b0612;
    outline-offset: 3px;
  }

  .stories-button[hidden] {
    display: none;
  }

  .stories-button--pause {
    width: 60px;
    height: 60px;
    background: #1b0612;
    color: #ff4f8b;
  }

  .stories-button svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stories-button--pause svg {
    stroke-width: 3;
  }

  .stories-icon-play {
    display: none;
    fill: currentColor !important;
  }

  .stories-button--pause[aria-pressed='true'] .stories-icon-play {
    display: block;
  }

  .stories-button--pause[aria-pressed='true'] .stories-icon-pause {
    display: none;
  }

  .stories-hint {
    font-size: 14px;
    font-weight: 650;
  }
</style>
