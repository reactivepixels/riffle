---
/**
 * Showcase scene 6: 9:16 story cards for a made-up weekend city guide, with
 * a segmented progress bar that auto-advances. Each story is a photo from
 * src/assets/showcase/stories, optimised by astro:assets. Mounted by src/lib/showcase/stories.ts, which owns the
 * timer and every reason it waits.
 */
import { Image } from 'astro:assets'
import Scene from './Scene.astro'
import breakfast from '../../assets/showcase/stories/breakfast.jpg'
import jacaranda from '../../assets/showcase/stories/jacaranda.jpg'
import market from '../../assets/showcase/stories/market.jpg'
import lake from '../../assets/showcase/stories/lake.jpg'
import tacos from '../../assets/showcase/stories/tacos.jpg'
import { storiesSource } from '../../lib/snippets'

interface Story {
  art: 'breakfast' | 'jacaranda' | 'market' | 'lake' | 'tacos'
  day: string
  time: string
  tag: string
  text: string
}

const stories: Story[] = [
  {
    art: 'breakfast',
    day: 'Saturday',
    time: '08:30',
    tag: 'Breakfast',
    text: 'Chilaquiles verdes and a coffee strong enough to argue with.',
  },
  {
    art: 'jacaranda',
    day: 'Saturday',
    time: '11:00',
    tag: 'Walk',
    text: 'Roma Norte under the jacarandas. Look up. The purple is the point.',
  },
  {
    art: 'market',
    day: 'Saturday',
    time: '14:00',
    tag: 'Lunch',
    text: 'A market counter, a plastic stool, and whatever the cook says is good today.',
  },
  {
    art: 'lake',
    day: 'Sunday',
    time: '10:00',
    tag: 'Park',
    text: 'Chapultepec by pedal boat. Go slowly and call it exercise.',
  },
  {
    art: 'tacos',
    day: 'Sunday',
    time: '13:00',
    tag: 'Tacos',
    text: 'Al pastor off the spit. Order two more than you planned.',
  },
]

const photos = { breakfast, jacaranda, market, lake, tacos }

const flags = ['#ff4f8b', '#ffd23f', '#3ad1c4', '#ff7a1a', '#8b5cf6', '#ffffff']
---

<Scene
  id="stories"
  index="06"
  title="City stories"
  lede="Advances on its own every five seconds and holds while you touch it."
  config={['next()', "on('dragstart')", 'prefers-reduced-motion']}
  code={storiesSource}
  class="stories-scene"
  style="--bg: #1e0f24; --ink: #f6e9f1;"
>
  <div class="stories-stage">
    <div class="stories-stack" data-stack role="group" aria-label="Two Days In, Mexico City">
      <div class="story-bar" data-bar aria-hidden="true">
        {
          stories.map((_, i) => (
            <span class:list={['story-bar__segment', { 'is-active': i === 0 }]}>
              <span class="story-bar__fill" />
            </span>
          ))
        }
      </div>

      {
        stories.map((s, i) => (
          <div
            class="story"
            data-label={`${s.day} ${s.time}, ${s.tag}: ${s.text}`}
            style={`z-index: ${stories.length - i};`}
          >
            <Image
              class="story__art"
              src={photos[s.art]}
              alt=""
              widths={[360, 720]}
              sizes="(min-width: 900px) 320px, 70vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />

            <div class="story__head">
              <span class="story__avatar" aria-hidden="true">2D</span>
              <p class="story__who">
                <span class="story__name">Two Days In</span>
                <span class="story__when">
                  Mexico City, {s.day.slice(0, 3)} {s.time}
                </span>
              </p>
            </div>

            <div class="story__caption">
              <p class="story__tag">
                {s.day} {s.time}, {s.tag}
              </p>
              <p class="story__text">{s.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="sc-controls">
      <button class="sc-button" type="button" data-prev aria-label="Previous story">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg>
      </button>
      <button
        class="sc-button stories-pause"
        type="button"
        data-pause
        aria-pressed="false"
        aria-label="Pause stories"
        hidden
      >
        <svg class="stories-icon-pause" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M9 6v12M15 6v12"></path></svg
        >
        <svg class="stories-icon-play" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M8 6v12l10-6Z"></path></svg
        >
      </button>
      <button class="sc-button" type="button" data-next aria-label="Next story">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
      </button>
      <p class="sc-note stories-hint">Hover, focus or grab a story to hold it.</p>
    </div>
  </div>
</Scene>

<script>
  import { mountWhenNear } from '../../lib/showcase/lazy'
  import { mountStories } from '../../lib/showcase/stories'

  const scene = document.getElementById('stories')
  if (scene) mountWhenNear(scene, () => mountStories(scene))
</script>

<style>
  .stories-stage {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .stories-stack {
    --w: min(320px, 64vw);
    position: relative;
    width: var(--w);
    aspect-ratio: 9 / 16;
    translate: calc(0.5 * (64px - 0.08 * var(--w))) 0;
  }

  .story-bar {
    position: absolute;
    z-index: 100;
    top: 3.2%;
    left: 5%;
    right: 5%;
    display: flex;
    gap: 4px;
    pointer-events: none;
  }

  .story-bar__segment {
    flex: 1;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(255 255 255 / 40%);
  }

  .story-bar__fill {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .story-bar__segment.is-done .story-bar__fill,
  .story-bar__segment.is-active .story-bar__fill {
    transform: scaleX(1);
  }

  .story-bar.is-running .story-bar__segment.is-active .story-bar__fill {
    animation: story-fill 5s linear forwards;
  }

  .story-bar.is-running.is-paused .story-bar__segment.is-active .story-bar__fill {
    animation-play-state: paused;
  }

  @keyframes story-fill {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  .story {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    overflow: hidden;
    border-radius: 22px;
    background: #1b0612;
    color: #fff;
    cursor: grab;
    will-change: transform;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 10%),
      0 2px 4px rgb(27 6 18 / 25%),
      0 30px 60px -20px rgb(27 6 18 / 60%);
  }

  .story:active {
    cursor: grabbing;
  }

  .story:focus-visible {
    outline: 3px solid #f6e9f1;
    outline-offset: 5px;
  }

  .story__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(12 4 16 / 55%), transparent 22%),
      linear-gradient(0deg, rgb(12 4 16 / 88%) 0%, rgb(12 4 16 / 55%) 26%, transparent 48%);
    pointer-events: none;
  }

  .story__head,
  .story__caption {
    position: absolute;
    z-index: 1;
    left: 6.5cqw;
    right: 6.5cqw;
  }

  .story__head {
    top: 10cqw;
    display: flex;
    align-items: center;
    gap: 3cqw;
  }

  .story__avatar {
    display: grid;
    place-items: center;
    width: 11cqw;
    height: 11cqw;
    flex: none;
    border-radius: 50%;
    background: #ffd60a;
    color: #1b0612;
    font: 900 max(10px, 4cqw) / 1 var(--font-display);
    letter-spacing: -0.04em;
    box-shadow: 0 0 0 0.8cqw rgb(255 255 255 / 85%);
  }

  .story__who {
    display: grid;
    gap: 0.6cqw;
  }

  .story__name {
    font-size: max(12px, 4.6cqw);
    font-weight: 800;
  }

  .story__when {
    font-size: max(11px, 3.8cqw);
    font-weight: 600;
  }

  .story__caption {
    bottom: 8cqw;
    display: grid;
    gap: 3cqw;
  }

  .story__tag {
    font: 500 max(11px, 3.6cqw) / 1 var(--font-display);
    opacity: 0.85;
  }

  .story__text {
    font-family: var(--font-display);
    font-size: max(15px, 6.4cqw);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .stories-pause[hidden] {
    display: none;
  }

  .stories-icon-play {
    display: none;
  }

  .stories-pause .stories-icon-play {
    fill: currentColor;
  }

  .stories-pause[aria-pressed='true'] .stories-icon-play {
    display: block;
  }

  .stories-pause[aria-pressed='true'] .stories-icon-pause {
    display: none;
  }

  .stories-hint {
    flex-basis: 100%;
  }
</style>
