---
/**
 * Showcase scene 5: stand-up coffee bags for a made-up roaster, one per
 * origin, a photographed bag cut out of its backdrop. Each bag carries the colours the whole scene floods
 * to (`data-flood`, `data-ink`) when it reaches the front; every flood and
 * ink pair clears WCAG AA (4.5:1 or better) for body text. Mounted by
 * src/lib/showcase/coffee.ts.
 */
import { Image } from 'astro:assets'
import Scene from './Scene.astro'
import ethiopia from '../../assets/showcase/bags/ethiopia.webp'
import colombia from '../../assets/showcase/bags/colombia.webp'
import kenya from '../../assets/showcase/bags/kenya.webp'
import guatemala from '../../assets/showcase/bags/guatemala.webp'
import sumatra from '../../assets/showcase/bags/sumatra.webp'
import brazil from '../../assets/showcase/bags/brazil.webp'
import { coffeeSource } from '../../lib/snippets'

interface Bag {
  origin: string
  region: string
  process: string
  notes: [string, string, string]
  roast: number
  roastName: string
  altitude: string
  variety: string
  bag: string
  flood: string
  ink: string
}

const bags: Bag[] = [
  {
    origin: 'Ethiopia',
    region: 'Yirgacheffe',
    process: 'Washed',
    notes: ['Jasmine', 'Bergamot', 'White peach'],
    roast: 1,
    roastName: 'Light',
    altitude: '2,000 m',
    variety: 'Heirloom',
    bag: '#e9772f',
    flood: '#f7b77a',
    ink: '#3a1d06',
  },
  {
    origin: 'Colombia',
    region: 'Huila',
    process: 'Washed',
    notes: ['Red apple', 'Panela', 'Cocoa'],
    roast: 3,
    roastName: 'Medium',
    altitude: '1,700 m',
    variety: 'Caturra',
    bag: '#e0313b',
    flood: '#b81d27',
    ink: '#fff1ea',
  },
  {
    origin: 'Kenya',
    region: 'Nyeri',
    process: 'Washed',
    notes: ['Blackcurrant', 'Grapefruit', 'Cane sugar'],
    roast: 2,
    roastName: 'Light medium',
    altitude: '1,800 m',
    variety: 'SL28',
    bag: '#6b34a3',
    flood: '#3d1a63',
    ink: '#f3e8ff',
  },
  {
    origin: 'Guatemala',
    region: 'Huehuetenango',
    process: 'Washed',
    notes: ['Milk chocolate', 'Almond', 'Orange'],
    roast: 3,
    roastName: 'Medium',
    altitude: '1,750 m',
    variety: 'Bourbon',
    bag: '#2f7d4f',
    flood: '#a8d5b5',
    ink: '#0d3320',
  },
  {
    origin: 'Sumatra',
    region: 'Gayo',
    process: 'Wet hulled',
    notes: ['Cedar', 'Dark chocolate', 'Clove'],
    roast: 5,
    roastName: 'Dark',
    altitude: '1,400 m',
    variety: 'Typica',
    bag: '#2b5168',
    flood: '#14232e',
    ink: '#d9f2ff',
  },
  {
    origin: 'Brazil',
    region: 'Mogiana',
    process: 'Natural',
    notes: ['Hazelnut', 'Caramel', 'Raisin'],
    roast: 4,
    roastName: 'Medium dark',
    altitude: '1,100 m',
    variety: 'Mundo Novo',
    bag: '#e0a81e',
    flood: '#ffd84d',
    ink: '#3b2a00',
  },
]

const photos: { [origin: string]: ImageMetadata } = {
  Ethiopia: ethiopia,
  Colombia: colombia,
  Kenya: kenya,
  Guatemala: guatemala,
  Sumatra: sumatra,
  Brazil: brazil,
}

const first = bags[0]!
const detail = (b: Bag) => `${b.process} · ${b.roastName} roast · ${b.notes.join(', ')}`
const describe = (b: Bag) =>
  `${b.origin}, ${b.region}, ${b.process.toLowerCase()}. ${b.roastName} roast. Notes of ${b.notes[0].toLowerCase()}, ${b.notes[1].toLowerCase()} and ${b.notes[2].toLowerCase()}`
---

<Scene
  id="coffee-origins"
  index="05"
  title="Coffee origins"
  lede="The page takes the colour of whichever bag is in front."
  config={["on('change')", "style.setProperty('--bg')", "style.setProperty('--ink')"]}
  code={coffeeSource}
  class="coffee-scene"
  style={`--bg: ${first.flood}; --ink: ${first.ink};`}
>
  <div class="coffee-stage">
    <div class="coffee-stack" data-stack role="group" aria-label="Fernwick coffee, single origins">
      {
        bags.map((b, i) => (
          <div
            class="bag"
            data-label={describe(b)}
            data-flood={b.flood}
            data-ink={b.ink}
            data-detail={detail(b)}
            style={`z-index: ${bags.length - i};`}
          >
            <Image
              class="bag__img"
              src={photos[b.origin]!}
              alt=""
              widths={[320, 640]}
              sizes="(min-width: 900px) 300px, 52vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        ))
      }
    </div>

    <p class="coffee-detail" data-detail-text aria-hidden="true">{detail(first)}</p>

    <div class="sc-controls">
      <button class="sc-button" type="button" data-prev aria-label="Previous bag">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6"></path></svg>
      </button>
      <p class="sc-note">Drag a bag or tap the arrows.</p>
      <button class="sc-button" type="button" data-next aria-label="Next bag">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
      </button>
    </div>
  </div>
</Scene>

<script>
  import { mountWhenNear } from '../../lib/showcase/lazy'
  import { mountCoffeeOrigins } from '../../lib/showcase/coffee'

  const scene = document.getElementById('coffee-origins')
  if (scene) mountWhenNear(scene, () => mountCoffeeOrigins(scene))
</script>

<style>
  :global(.coffee-scene) {
    transition:
      background-color 800ms var(--ease-out),
      color 800ms var(--ease-out);
  }




  .coffee-stage {
    display: grid;
    justify-items: center;
    width: 100%;
  }

  .coffee-stack {
    --w: min(290px, 54vw);
    position: relative;
    width: var(--w);
    aspect-ratio: 1027 / 1678;
    translate: calc(0.5 * (108px - 0.09 * var(--w))) 0;
  }

  .bag {
    position: absolute;
    inset: 0;
    container-type: inline-size;
    cursor: grab;
    will-change: transform;
  }

  /*
   * A soft contact shadow under each bag, drawn as its own gradient rather
   * than a drop-shadow filter on the photo: browsers clip a filter on a
   * transformed element to its box, which reads as a hard outline.
   */
  .bag::before {
    content: '';
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: -3%;
    height: 8%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 38%), rgb(0 0 0 / 0%));
    pointer-events: none;
  }

  .bag:active {
    cursor: grabbing;
  }

  .bag:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 6px;
    border-radius: 18px;
  }

  .coffee-detail {
    margin-top: 32px;
    font-size: 15px;
    font-weight: 500;
    text-align: center;
  }

  .bag__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: relative;
    pointer-events: none;
    user-select: none;
  }
</style>
