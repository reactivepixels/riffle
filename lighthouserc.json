{
  "ci": {
    "collect": {
      "startServerCommand": "node apps/docs/scripts/serve-dist.mjs",
      "startServerReadyPattern": "Serving .* at http://localhost:4173/riffle/",
      "startServerReadyTimeout": 15000,
      "url": [
        "http://localhost:4173/riffle/",
        "http://localhost:4173/riffle/vanilla/getting-started/",
        "http://localhost:4173/riffle/react/getting-started/",
        "http://localhost:4173/riffle/vue/getting-started/",
        "http://localhost:4173/riffle/vanilla/api/functions/createriffle/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
